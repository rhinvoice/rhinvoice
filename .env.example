# Copy to .env and adjust. Never commit .env.

# Name of this installation for Docker (containers, data volume). Change it to run
# several installations side by side, e.g. rhinvoice-test; then docker compose uses
# it without "-p". Keep it once data exists: a new name starts with an empty database.
COMPOSE_PROJECT_NAME=rhinvoice

# Database password (letters and digits only, it is embedded in a URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Address and port the web interface listens on. 127.0.0.1 = only this machine
# (recommended behind a reverse proxy); 0.0.0.0 = whole network.
RHINVOICE_BIND=127.0.0.1
RHINVOICE_PORT=8000

# Session cookies are only sent over HTTPS. Set to false ONLY if you access
# Rhinvoice over plain HTTP in a trusted network (not http://localhost).
RHINVOICE_COOKIE_SECURE=true

# IP of your reverse proxy (for correct client IPs and https detection).
RHINVOICE_FORWARDED_ALLOW_IPS=127.0.0.1

# Timezone used for "today" (document dates, due dates).
RHINVOICE_TIMEZONE=Europe/Zurich

# Apply database migrations on start.
RHINVOICE_RUN_MIGRATIONS=true

# Recurring invoices: written in the background, every RHINVOICE_RECURRING_INTERVAL seconds.
#RHINVOICE_RECURRING=true
#RHINVOICE_RECURRING_INTERVAL=600

# New versions: once a day the app reads the signed release.json of the latest GitHub release
# and shows a notice when a newer version exists. It is a plain download: GitHub sees the
# server's address as with any download; no data of this installation is sent.
#RHINVOICE_UPDATE_CHECK=true

# Image version to run, e.g. 0.8.0 (see GitHub releases). Pin a version: updates
# then only happen when you change it. "latest" follows every release.
RHINVOICE_VERSION=latest

# --- Backup (docs/backup.md) -------------------------------------------------
# Where the encrypted backups go (restic repository), e.g.
#   s3:https://s3.eu-central-003.backblazeb2.com/my-bucket/rhinvoice
#   sftp:user@nas.example:/backups/rhinvoice
#   rclone:dropbox:Rhinvoice-Backup   (Dropbox, Google Drive ... via rclone)
#   /repository   (a folder of this machine, see BACKUP_LOCAL_DIR)
# Empty: no backups; the dashboard says so.
RESTIC_REPOSITORY=
# Encrypts the backups. Keep it safe elsewhere too: without it no restore is possible.
# Use `openssl rand -hex 32` or single quotes: Compose changes a "$" in unquoted values.
RESTIC_PASSWORD=
# Credentials of S3-compatible storage (AWS, Backblaze B2, Infomaniak Swiss Backup, ...).
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
# Folder of this machine for RESTIC_REPOSITORY=/repository (e.g. an iCloud or
# Nextcloud folder). Empty: a Docker volume on the same disk (no real backup).
#BACKUP_LOCAL_DIR=/path/to/folder
# Daily backup time (local time, RHINVOICE_TIMEZONE).
#BACKUP_DAILY_AT=02:00
# Name of this installation in the repository; only needed when several share one.
#BACKUP_HOST=rhinvoice
