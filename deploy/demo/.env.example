# Copy to .env and adjust. Never commit .env.

# The demos answer at ch.<DEMO_DOMAIN>, de.<DEMO_DOMAIN> and at.<DEMO_DOMAIN>;
# point these three DNS names (A/AAAA records) at this server first.
DEMO_DOMAIN=demo.example.org

# Let's Encrypt writes here when a certificate is about to expire.
ACME_EMAIL=admin@example.org

# Database password (letters and digits only, it is embedded in a URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Seconds between two resets (at least 300).
DEMO_RESET_INTERVAL=3600

# The image to run: a released version with the demo mode (0.4.0 or later).
RHINVOICE_IMAGE=ghcr.io/rhinvoice/rhinvoice:0.4.0
