<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the headless Chromium in Rhinvoice.app may do under the hardened runtime (ADR 0036): its
  JavaScript engine compiles code while it prints the PDFs, as Chrome's own helpers do.
  PostgreSQL and restic get no entitlements at all.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
</dict>
</plist>
