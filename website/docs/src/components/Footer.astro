---
// Starlight's footer (edit link, last change, previous and next page), then the legal pages.
import Default from "@astrojs/starlight/components/Footer.astro";

import { words } from "../lib/ui";

const { legal, noTaxAdvice, legalLinks } = words(Astro.locals.starlightRoute.lang);
---

<Default />
<nav class="legal-links" aria-label={legal}>
  <span>Rhinvoice · AGPL-3.0 · {noTaxAdvice}</span>
  {legalLinks.map(([href, label]) => <a href={href}>{label}</a>)}
  <a href="https://www.webberz.ch/">made by webberz</a>
</nav>

<style>
  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }
  .legal-links span {
    margin-inline-end: auto;
  }
  .legal-links a {
    color: inherit;
  }
  .legal-links a:hover {
    color: var(--sl-color-white);
  }
</style>
