---
// Starlight's footer (edit link, last change, previous and next page), then the legal pages.
import Default from "@astrojs/starlight/components/Footer.astro";

const german = Astro.locals.starlightRoute.lang === "de";
const links = german
  ? [
      ["/de/impressum/", "Impressum"],
      ["/de/datenschutz/", "Datenschutz"],
    ]
  : [
      ["/legal-notice/", "Legal notice"],
      ["/privacy/", "Privacy"],
    ];
---

<Default />
<nav class="legal-links" aria-label={german ? "Rechtliches" : "Legal"}>
  <span>Rhinvoice · AGPL-3.0 · {german ? "Keine Steuerberatung" : "No tax advice"}</span>
  {links.map(([href, label]) => <a href={href}>{label}</a>)}
  <a href="https://www.webberz.ch/">made by webberz</a>
</nav>

<style>
  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }
  .legal-links span {
    margin-inline-end: auto;
  }
  .legal-links a {
    color: inherit;
  }
  .legal-links a:hover {
    color: var(--sl-color-white);
  }
</style>
