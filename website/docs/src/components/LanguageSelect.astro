---
// DE | EN | FR | IT as links, as on rhinvoice.com: one click, no menu.
import { LANGUAGES, languageOf, languagePath } from "../lib/paths";
import { words } from "../lib/ui";

const { lang } = Astro.locals.starlightRoute;
const current = languageOf(lang);
---

<nav class="lang" aria-label={words(lang).language}>
  {
    LANGUAGES.map((code) => (
      <a
        href={languagePath(Astro.url.pathname, current, code)}
        hreflang={code}
        lang={code}
        aria-current={code === current ? "true" : undefined}
      >
        {code.toUpperCase()}
      </a>
    ))
  }
</nav>

<style>
  .lang {
    display: flex;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    overflow: hidden;
    font-size: var(--sl-text-sm);
  }
  .lang a {
    display: grid;
    place-items: center;
    min-width: 2.25rem;
    min-height: 1.75rem;
    padding-inline: 0.6rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .lang a:hover {
    color: var(--sl-color-white);
  }
  .lang a[aria-current] {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-weight: 600;
  }
</style>
